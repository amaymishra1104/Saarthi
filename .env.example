# SAARTHI Environment Configuration

PROJECT_NAME=SAARTHI
VERSION=1.0.0
ENVIRONMENT=development

# Database (SQLite by default, PostgreSQL-ready: postgresql+psycopg2://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./saarthi.db

# Simulated Connected System: Payments Core API
PAYMENTS_API_KEY=saarthi-mock-bank-key-secret-2026
AUTO_ACTION_LIMIT=5000.00

# LLM Intelligence Configuration
# MOCK_LLM=true (default) runs the deterministic offline engine: no key needed,
# all 27 tests + all 9 demo scenarios pass with zero external credentials.
#
# To use a REAL LLM instead, set MOCK_LLM=false and provide a key:
#  - EMERGENT_LLM_KEY  -> universal key, works with any provider/model below (recommended)
#  - GEMINI_API_KEY    -> legacy direct Gemini path
EMERGENT_LLM_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4
MOCK_LLM=true

